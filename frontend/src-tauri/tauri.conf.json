{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TinyLM Council",
  "version": "0.7.1",
  "identifier": "com.tinylmcouncil.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TinyLM Council",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/tinylm-council-api"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "Multi-LLM council for tiny local models",
    "longDescription": "TinyLM Council runs a local multi-model deliberation UI backed by Ollama, LM Studio, or cloud providers.",
    "category": "Productivity",
    "copyright": "TinyLM Council contributors"
  }
}
